# Ballo Dash environment. Copy to .env for local development.
# Validated at server start by src/env.ts; a missing or malformed value stops the server with a message.

# development | preview | staging | production
APP_ENV=development
# debug | info | warn | error (default: debug in development, info otherwise)
LOG_LEVEL=

# Postgres. Use DATABASE_SSL=require for any remote database (mandatory in staging and production).
DATABASE_URL=postgres://USER@localhost:5432/ballo_dash_dev
DATABASE_SSL=disable
DATABASE_POOL_MAX=5

# NextAuth. Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Encrypts integration tokens and app secrets at rest. Generate with: openssl rand -base64 32
# To rotate: move the old value to TOKEN_ENCRYPTION_KEY_PREVIOUS, set a new key, then run
# npx tsx scripts/encrypt-integration-secrets.ts
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# Upstash Redis: API cache and rate limiting. Required in staging and production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# S3 for company logos. Without these, uploads answer 503.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# OAuth redirect URIs registered with each platform.
FACEBOOK_REDIRECT_URI=
INSTAGRAM_REDIRECT_URI=
LINKEDIN_REDIRECT_URI=
X_REDIRECT_URI=

# Claude API for AI insights (phase 2 onward). Blank = template fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Local scripts only.
# Password for the admin users created by `npm run db:seed` (at least 12 characters).
SEED_ADMIN_PASSWORD=
# Integration tests: defaults to postgres://$USER@localhost:5432/ballo_dash_test
TEST_DATABASE_URL=

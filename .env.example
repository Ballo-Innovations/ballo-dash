# Ballo Dash web app. Copy to .env for local development.

# Base URL of the Ballo Dash API (ballo-dash-api). /api/* is forwarded there.
# Local: http://localhost:3001   Vercel: the staging or production API hostname.
API_ORIGIN=http://localhost:3001

# Must equal the API's SESSION_SECRET. Used only to check the session cookie
# before showing a page; the API authorises every request itself.
SESSION_SECRET=

# Feature flags (see docs/feature-promotion.md). Unset: on in development, off elsewhere.
NEXT_PUBLIC_FEATURE_LISTENING=
NEXT_PUBLIC_FEATURE_KPI_DASHBOARD=

# End-to-end tests (local)
E2E_API_DATABASE_URL=            # the API's local database; default ballo_dash_api_dev on localhost
E2E_BASE_URL=                    # test a deployed environment instead (needs E2E_EMAIL, E2E_PASSWORD)

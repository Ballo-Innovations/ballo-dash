{
  "name": "ballo-dash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings=600",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "drizzle:push": "drizzle-kit push",
    "drizzle:seed": "tsx ./src/db/seed.ts",
    "drizzle:reset": "tsx src/db/reset.ts && tsx src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.817.0",
    "@aws-sdk/s3-request-presigner": "^3.817.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.1.1",
    "@reduxjs/toolkit": "^2.1.0",
    "@south-paw/react-vector-maps": "^3.2.0",
    "@tanstack/match-sorter-utils": "^8.11.8",
    "@tanstack/react-table": "^8.11.8",
    "@types/i18next-browser-languagedetector": "^3.0.0",
    "@upstash/redis": "^1.35.0",
    "apexcharts": "^3.54.1",
    "bcryptjs": "^3.0.2",
    "bootstrap": "5.3.0",
    "clipboard": "^2.0.11",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-seed": "^0.3.1",
    "feather-icons-react": "^0.7.0",
    "framer-motion": "^12.15.0",
    "i18next": "^24.1.2",
    "i18next-browser-languagedetector": "^8.0.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.511.0",
    "next": "^15.5.29",
    "next-auth": "^4.24.11",
    "next-i18next": "^15.4.1",
    "next-redux-wrapper": "^8.1.0",
    "pg": "^8.16.0",
    "react": "^18.2.0",
    "react-apexcharts": "^1.4.1",
    "react-bootstrap": "^2.10.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.57.0",
    "react-hot-toast": "^2.5.2",
    "react-i18next": "^15.2.0",
    "react-redux": "^9.1.0",
    "reselect": "^5.1.0",
    "sass": "^1.87.0",
    "simplebar-react": "^3.2.4",
    "uppy": "^4.15.0",
    "uuid": "^11.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.5.29",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.11"
  }
}
